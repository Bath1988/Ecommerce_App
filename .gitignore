# dependencies
/node_modules
/api/node_modules
/frontend/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
frontend/build/


# misc
.DS_Store
Thumbs.db
*.swp
*.swo
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environments
venv/
*/venv/
chatbot_api/venv/

# Python cache
__pycache__/
*.pyc

# Environment files
.env
chatbot_api/.env

# Docker artifacts
*.pid
*.sock
docker-compose.*.yml.override
docker-compose.override.yml
docker-compose.*.env
docker-compose.env
docker-compose.log

# AWS credentials and configs
aws/

# AWS
aws/